# Set only the providers you actually use. Never commit real credentials.
OPENAI_API_KEY=
IMAGE_PROVIDER=
TTS_PROVIDER=
MUSIC_PROVIDER=
VIDEO_PROVIDER=
LOCAL_VIDEO_PROVIDER=comfyui
LOCAL_COMFYUI_URL=http://127.0.0.1:8188
OPENMONTAGE_HOME=

# Optional local voice runtime; export in the shell (no automatic .env loading).
VOICEVOX_RUNTIME=outputs/local-voice-provider/runtime
# Set the matching native .dylib / .so / .dll file when auto-discovery is insufficient.
VOICEVOX_ONNXRUNTIME=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# macOS fonts are defaults; on other systems supply installed CJK/label font files.
# ANIME_CJK_FONT=/path/to/CJK-font.ttc
# ANIME_SERIF_FONT=/path/to/serif-font.ttc
# ANIME_LABEL_FONT=/path/to/label-font.ttf
